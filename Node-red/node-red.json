        "name": "actualizar estado y fecha finalizado",
        "func": "const p = msg.payload || {};\n\nif (!p.numero_pedido) {\n    node.error(\"No se proporcionó un número_pedido para actualizar.\");\n    return null; \n}\n\n\nconst mongoMsg = {\n    // 1. La condición de búsqueda SIEMPRE va en msg.query\n    query: { \n        numero_pedido: p.numero_pedido \n    },\n    \n    // 2. Los datos a actualizar SIEMPRE van en msg.payload\n    payload: { \n        $set: { \n            estado: \"finalizado\",\n            \"fechas.fecha_finalizado\": new Date() \n        } \n    }\n};\nreturn mongoMsg;\n\n/*\ndb.proyecto.updateOne(\n    { numero_pedido: p.numero_pedido }, \n    { $set: { estado: \"finalizado\", \"fechas.fecha_finalizado\": new Date() } }\n)\n*/",
