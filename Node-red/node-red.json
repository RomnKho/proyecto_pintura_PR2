        "name": "Guardar datos y crear pedido",
        "func": "const p = msg.payload || {};\n\nflow.set(\"cliente_nombre\", p.cliente_nombre || \"\");\nflow.set(\"cliente_telefono\", p.cliente_telefono || \"\");\nflow.set(\"cliente_email\", p.cliente_email || \"\");\nflow.set(\"cliente_observaciones\", p.cliente_observaciones || \"\");\nflow.set(\"color_elegido\", p.color_elegido || \"#ffffff\");\nflow.set(\"cantidad_elegida\", Number(p.cantidad_elegida || 1));\nflow.set(\"tamano_elegido\", p.tamano_elegido || \"\");\nflow.set(\"tipo_elegido\", p.tipo_elegido || \"\");\n\n// Salida pedido completo para MongoDB\nconst mongoMsg = {\n    payload: {\n        numero_pedido: \"PED-\" + Date.now(),\n\n        cliente: {\n            nombre:   p.cliente_nombre   || \"Sin nombre\",\n            telefono: p.cliente_telefono || \"\",\n            email:    p.cliente_email    || \"\"\n        },\n\n        pedido: {\n            producto: \"Pintura personalizada\",\n            color:    p.color_elegido    || \"Sin color\",\n            cantidad: Number(p.cantidad_elegida || 1),\n            tamano:   p.tamano_elegido   || \"Sin tamaño\",\n            tipo:     p.tipo_elegido     || \"Sin tipo\"\n        },\n\n        estado: \"pendiente\",\n\n        fechas: {\n            fecha_pedido:     new Date(),\n            fecha_produccion: null,\n            fecha_finalizado: null\n        },\n\n        observaciones: p.cliente_observaciones || \"Pedido enviado desde la app\"\n    }\n};\n\n// Salida payload para MQTT\nconst mqttMsg = {\n    payload: {\n        numero_pedido: \"PED-\" + Date.now(),\n        rgb_hex:  p.color_elegido || \"ffffff\",\n        tamano:   p.tamano_elegido || \"M\",\n        cantidad: Number(p.cantidad_elegida || 1),\n        tipo:     p.tipo_elegido || \"Ext\"\n    }\n};\n\n// Salida 3: debug del formulario\nconst debugMsg = { payload: p };\n\nreturn [mongoMsg, mqttMsg, debugMsg];",
